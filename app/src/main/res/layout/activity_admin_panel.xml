<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="20dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="Yönetici Paneli"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvWelcome"
                android:text="Hoşgeldin, Admin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnLogout"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_lock_power_off"
            android:contentDescription="logout"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
    </RelativeLayout>

    <androidx.gridlayout.widget.GridLayout
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:columnCount="2"
        app:rowCount="2">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardListings"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_margin="10dp"
            app:layout_columnWeight="1"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:src="@android:drawable/ic_menu_edit"
                    android:layout_width="36dp"
                    android:layout_height="36dp"/>
                <TextView
                    android:layout_marginTop="8dp"
                    android:text="Tüm İlanlar"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUsers"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_margin="10dp"
            app:layout_columnWeight="1"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:layout_width="36dp"
                    android:layout_height="36dp"/>
                <TextView
                    android:layout_marginTop="8dp"
                    android:text="Kullanıcılar"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BAŞVURU KARTI (YENİDEN EKLENDİ) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRequests" 
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_margin="10dp"
            app:layout_columnWeight="1"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:src="@android:drawable/ic_menu_agenda"
                    android:layout_width="36dp"
                    android:layout_height="36dp"/>
                <TextView
                    android:layout_marginTop="8dp"
                    android:text="Başvuru Yönetimi"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.gridlayout.widget.GridLayout>
</LinearLayout>
